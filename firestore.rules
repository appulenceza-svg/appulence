rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin access helper
    function isAdmin() {
      return request.auth != null && request.auth.token.role == "admin";
    }

    // Sales Representative access helper
    function isSalesRep() {
      return request.auth != null && request.auth.token.role == "sales_rep";
    }

    // Customer access helper
    function isCustomer() {
      return request.auth != null && request.auth.token.role == "customer";
    }

    // Match users collection
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Users can only write their own doc if they aren't trying to change their role to admin/customer maliciously, 
      // or if they are admin
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }

    // Match customers collection
    match /customers/{customerId} {
      allow read: if isAdmin() || (isSalesRep() && resource.data.ownerId == request.auth.uid) || (isCustomer() && (request.auth.token.customerId == customerId || request.auth.token.customerId == resource.data.customerId));
      allow create: if isAdmin() || (isSalesRep() && request.resource.data.ownerId == request.auth.uid) || (isCustomer() && request.auth.token.customerId == request.resource.data.customerId);
      allow update: if isAdmin() || (isSalesRep() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid) || (isCustomer() && resource.data.customerId == request.auth.token.customerId && request.resource.data.customerId == request.auth.token.customerId);
      allow delete: if isAdmin() || (isSalesRep() && resource.data.ownerId == request.auth.uid);

      // Contacts subcollection
      match /contacts/{contactId} {
        allow read: if isAdmin() || (isSalesRep() && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) || (isCustomer() && (request.auth.token.customerId == customerId || get(/databases/$(database)/documents/customers/$(customerId)).data.customerId == request.auth.token.customerId));
        allow write: if isAdmin() || (isSalesRep() && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) || (isCustomer() && (request.auth.token.customerId == customerId || get(/databases/$(database)/documents/customers/$(customerId)).data.customerId == request.auth.token.customerId));
      }

      // Notes subcollection
      match /notes/{noteId} {
        allow read: if isAdmin() || (isSalesRep() && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) || (isCustomer() && (request.auth.token.customerId == customerId || get(/databases/$(database)/documents/customers/$(customerId)).data.customerId == request.auth.token.customerId));
        allow write: if isAdmin() || (isSalesRep() && get(/databases/$(database)/documents/customers/$(customerId)).data.ownerId == request.auth.uid) || (isCustomer() && (request.auth.token.customerId == customerId || get(/databases/$(database)/documents/customers/$(customerId)).data.customerId == request.auth.token.customerId));
      }
    }

    // Match deals collection and nested activities
    match /deals/{dealId} {
      allow read: if isAdmin() || isSalesRep() || (isCustomer() && request.auth.token.customerId == resource.data.customerId);
      allow create: if isAdmin() || (isSalesRep() && request.resource.data.ownerId == request.auth.uid) || (isCustomer() && request.auth.token.customerId == request.resource.data.customerId);
      allow update: if isAdmin() || (isSalesRep() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid) || (isCustomer() && resource.data.customerId == request.auth.token.customerId && request.resource.data.customerId == request.auth.token.customerId);
      allow delete: if isAdmin();

      match /activities/{activityId} {
        allow read: if isAdmin() || isSalesRep();
        allow create, update: if isAdmin() || isSalesRep();
        allow delete: if isAdmin();
      }
    }

    // Match quotes collection
    match /quotes/{quoteId} {
      allow read: if isAdmin() || isSalesRep() || (isCustomer() && request.auth.token.customerId == resource.data.customerId);
      
      allow create: if isAdmin() || (isSalesRep() && get(/databases/$(database)/documents/customers/$(request.resource.data.customerId)).data.ownerId == request.auth.uid) || (isCustomer() && request.auth.token.customerId == request.resource.data.customerId);
      
      allow update: if isAdmin() || 
                    (isSalesRep() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.ownerId == request.auth.uid) ||
                    (isCustomer() && 
                     request.auth.token.customerId == resource.data.customerId && 
                     resource.data.status == "Sent" && 
                     (request.resource.data.status == "Accepted" || request.resource.data.status == "Rejected") &&
                     request.resource.data.customerId == resource.data.customerId &&
                     request.resource.data.quoteNumber == resource.data.quoteNumber &&
                     request.resource.data.total == resource.data.total);
                     
      allow delete: if isAdmin() || (isSalesRep() && get(/databases/$(database)/documents/customers/$(resource.data.customerId)).data.ownerId == request.auth.uid);
    }

    // Match catalog collection
    match /catalog/{itemId} {
      allow read: if isAdmin() || isSalesRep();
      allow write: if isAdmin();
    }

    // Match targets collection
    match /targets/{targetId} {
      allow read: if isAdmin() || isSalesRep();
      allow write: if isAdmin();
    }

    // Match ai_leads collection
    match /ai_leads/{leadId} {
      allow read, write: if isAdmin() || isSalesRep();
    }

    // Match schools_onboardings collection
    match /schools_onboardings/{onboardingId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin() || isSalesRep());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }


    // Match support_chats collection
    match /support_chats/{chatId} {
      allow read, write: if true; // In production this should be restricted, but for the chatbot to work for anonymous users we allow it.
    }

    // Default catch-all rule: Only authenticated users can read/write, and admins can do everything

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
